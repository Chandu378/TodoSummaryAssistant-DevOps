# Local Docker Compose. Copy to .env; replace values before starting.
MYSQL_DATABASE=todo
DB_USERNAME=todo
DB_PASSWORD=replace-with-a-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-local-password
# Compose backend uses mysql; native Java must use localhost instead.
DB_URL=jdbc:mysql://mysql:3306/todo
COHERE_API_KEY=
SLACK_WEBHOOK_URL=
CORS_ALLOWED_ORIGINS=http://localhost:3000
DDL_AUTO=update
DB_POOL_SIZE=5
MANAGEMENT_PORT=8081
APP_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-grafana-password
# Frontend build-time PUBLIC setting; never put secrets here.
REACT_APP_API_BASE_URL=/api/todos
# Production configuration is generated from AWS; see aws/aws-setup.md.
# AWS_REGION, ECR_REGISTRY, RELEASE_SHA, BACKEND_REPOSITORY, FRONTEND_REPOSITORY,
# RDS_ENDPOINT, RDS_SECRET_ARN, APP_SECRET_ARN, ARTIFACT_BUCKET, DEPLOY_DOCUMENT.
# AWS credentials use IAM roles, not this file.
